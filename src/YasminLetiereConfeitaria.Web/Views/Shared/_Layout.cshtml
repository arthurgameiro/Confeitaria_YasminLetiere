@inject YasminLetiereConfeitaria.Domain.Interfaces.ISazonalidadeRepository SazonalidadeRepo
@inject YasminLetiereConfeitaria.Domain.Interfaces.IRedeSocialRepository RedeSocialRepo
@inject YasminLetiereConfeitaria.Domain.Interfaces.IConfiguracaoSistemaRepository ConfigRepo
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Yasmin Letiere Confeitaria</title>
    
    <!-- Google Fonts: Cormorant Garamond (Serif clássico) e Montserrat (Sans-serif moderno) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Material Icons para símbolos e glyphs -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- FontAwesome para ícones oficiais de redes sociais -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="main-header">
        <nav class="navbar container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <!-- SVG Logo Yasmin Letiere Confeitaria -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="logo-svg">
                    <path id="curve-top-nav" d="M 18,50 A 32,32 0 0,1 82,50" fill="none" />
                    <path id="curve-bottom-nav" d="M 82,50 A 32,32 0 0,1 18,50" fill="none" />
                    <text fill="var(--bg-cream-light)" font-family="var(--font-heading)" font-size="7.5" font-weight="600" letter-spacing="0.5">
                        <textPath href="#curve-top-nav" startOffset="50%" text-anchor="middle">Yasmin Letiere</textPath>
                    </text>
                    <text fill="var(--bg-cream-light)" font-family="var(--font-heading)" font-size="7.5" font-weight="600" letter-spacing="1">
                        <textPath href="#curve-bottom-nav" startOffset="50%" text-anchor="middle">Confeitaria</textPath>
                    </text>
                    <!-- Monogram central estilizado -->
                    <path d="M 38,42 C 38,38 42,36 45,38 C 47,40 43,48 40,51 C 37,54 35,59 36,63 C 38,68 45,71 52,69 C 59,67 63,61 63,58 C 63,55 58,56 56,58 C 54,60 55,64 58,64 C 61,64 63,60 62,56 M 46,31 C 48,28 52,27 55,30 C 57,33 52,40 49,44 C 46,48 45,52 47,56 C 49,60 54,62 59,59" fill="none" stroke="var(--accent-gold)" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <div class="brand-text">
                    <span class="brand-name">Yasmin Letiere</span>
                    <span class="brand-sub">Confeitaria Gourmet</span>
                </div>
            </a>
            
            <button class="menu-toggle" aria-label="Abrir menu" id="mobile-menu-btn">
                <span class="material-icons">menu</span>
            </button>
            
            @{
                var dbSeasons = (await SazonalidadeRepo.GetAllAsync());
                var catalogoSazonalAtivo = await ConfigRepo.GetBoolAsync("catalogo_sazonal_ativo", true);
                var agora = DateTime.UtcNow;
                var activeSeasons = dbSeasons
                    .Where(s => s.Ativo && agora >= s.DataInicio && agora <= s.DataFim)
                    .OrderBy(s => s.DataInicio)
                    .ToList();
                var hasActiveSeasons = catalogoSazonalAtivo && activeSeasons.Any();
                var redesAtivas = (await RedeSocialRepo.GetAtivasOrdenadasAsync()).ToList();
            }
            <ul class="nav-menu" id="nav-menu">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Início</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Cardapio">Cardápio Fixo</a>
                </li>
                <li class="nav-item @(hasActiveSeasons ? "dropdown" : "")">
                    <a class="nav-link sazonal-link @(hasActiveSeasons ? "" : "disabled-sazonal-link")" asp-controller="Home" asp-action="Sazonal">Cardápios Temporários</a>
                    @if (hasActiveSeasons)
                    {
                        <ul class="dropdown-menu">
                            @foreach (var s in activeSeasons)
                            {
                                var emoji = !string.IsNullOrEmpty(s.Icone) ? s.Icone :
                                            s.Nome == "Páscoa" ? "🐇" :
                                            s.Nome == "Natal" ? "🎄" :
                                            s.Nome == "Namorados" ? "💖" :
                                            s.Nome.Contains("Mães") ? "👩‍👦" :
                                            s.Nome.Contains("Pais") ? "👨‍👦" :
                                            s.Nome.Contains("Junina") ? "🌽" :
                                            s.Nome.Contains("Halloween") ? "🎃" :
                                            s.Nome.Contains("Crianças") ? "🎈" :
                                            s.Nome.Contains("Carnaval") ? "🎭" :
                                            s.Nome.Contains("Réveillon") ? "🥂" :
                                            s.Nome.Contains("Mulher") ? "💐" : "✨";
                                <li><a asp-controller="Home" asp-action="Sazonal" asp-route-season="@s.Nome">@s.Nome @emoji</a></li>
                            }
                        </ul>
                    }
                </li>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link admin-highlight" asp-controller="Admin" asp-action="Index">
                            <span class="material-icons" style="font-size:1rem;vertical-align:middle;margin-right:3px;">admin_panel_settings</span>Admin
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link nav-btn" href="https://wa.me/message/3DAIKNWMQVTAM1" target="_blank">Atendimento WhatsApp</a>
                    </li>
                }
            </ul>
        </nav>
    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Html.PartialAsync("_AdminSubnav")
    }

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="main-footer">
        <div class="container footer-grid">
            <div class="footer-info">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="logo-svg-footer">
                    <circle cx="50" cy="50" r="46" fill="#0f3260" stroke="#f5ebe0" stroke-width="1.5"/>
                    <path id="curve-top-footer" d="M 18,50 A 32,32 0 0,1 82,50" fill="none" />
                    <path id="curve-bottom-footer" d="M 82,50 A 32,32 0 0,1 18,50" fill="none" />
                    <text fill="#f5ebe0" font-family="'Playfair Display', serif" font-size="7.5" font-weight="600" letter-spacing="0.5">
                        <textPath href="#curve-top-footer" startOffset="50%" text-anchor="middle">Yasmin Letiere</textPath>
                    </text>
                    <text fill="#f5ebe0" font-family="'Playfair Display', serif" font-size="7.5" font-weight="600" letter-spacing="1">
                        <textPath href="#curve-bottom-footer" startOffset="50%" text-anchor="middle">Confeitaria</textPath>
                    </text>
                    <path d="M 38,42 C 38,38 42,36 45,38 C 47,40 43,48 40,51 C 37,54 35,59 36,63 C 38,68 45,71 52,69 C 59,67 63,61 63,58 C 63,55 58,56 56,58 C 54,60 55,64 58,64 C 61,64 63,60 62,56 M 46,31 C 48,28 52,27 55,30 C 57,33 52,40 49,44 C 46,48 45,52 47,56 C 49,60 54,62 59,59" fill="none" stroke="#f5ebe0" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <h3>Yasmin Letiere Confeitaria</h3>
                <p class="sweet-quote">"Criando momentos doces e inesquecíveis com sabor e afeto."</p>
                <div class="badge-award">
                    <span class="material-icons text-gold">workspace_premium</span>
                    <span>Vencedora do "Que Seja Doce" GNT</span>
                </div>
            </div>
            
            <div class="footer-links">
                <h4>Navegação</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Início</a></li>
                    <li><a asp-controller="Home" asp-action="Cardapio">Cardápio Fixo</a></li>
                    <li><a class="sazonal-link @(hasActiveSeasons ? "" : "disabled-sazonal-link")" asp-controller="Home" asp-action="Sazonal">Cardápios Temporários</a></li>
                    <li><a asp-controller="Auth" asp-action="Login">Área da Confeiteira</a></li>
                </ul>
            </div>
            
            <div class="footer-contact">
                <h4>Contato & Horários</h4>
                <p><span class="material-icons text-cream">location_on</span> Freguesia - Rio de Janeiro - RJ</p>
                <p><span class="material-icons text-cream">schedule</span> Terça a Sábado: 10h às 19h<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Domingo: 09h às 13h</p>
                <p><span class="material-icons text-cream">chat</span> Encomendas pelo WhatsApp</p>
                <div class="social-links">
                    @if (redesAtivas.Any())
                    {
                        @foreach (var rede in redesAtivas)
                        {
                            <a href="@rede.Url" target="_blank" class="social-link" title="@rede.Nome" style="text-decoration: none;">
                                @if (rede.Icone.StartsWith("fa-"))
                                {
                                    <i class="@rede.Icone"></i>
                                }
                                else
                                {
                                    <span class="material-icons">@rede.Icone</span>
                                }
                            </a>
                        }
                    }
                    else
                    {
                        @* Fallback quando não há redes cadastradas *@
                        <a href="https://wa.me/message/3DAIKNWMQVTAM1" class="social-link" target="_blank" aria-label="WhatsApp">
                            <span class="material-icons">chat</span>
                        </a>
                    }
                </div>
            </div>
        </div>
        
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year Yasmin Letiere Confeitaria. Todos os direitos reservados. Feito com amor e C#.</p>
        </div>
    </footer>

    <!-- Botão Flutuante do WhatsApp -->
    <a href="https://wa.me/message/3DAIKNWMQVTAM1" class="whatsapp-float" target="_blank" aria-label="Fale conosco no WhatsApp">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="whatsapp-icon">
            <path fill="#fff" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L3 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3 18.7-68.1-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span class="tooltip-text">Fale Conosco!</span>
    </a>

    <script>
        window.hasActiveSeasons = @(hasActiveSeasons ? "true" : "false");
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
