@model YasminLetiereConfeitaria.Domain.Entities.Product

@{
    ViewData["Title"] = "Editar Produto";
    var categories = ViewBag.Categories as IEnumerable<YasminLetiereConfeitaria.Domain.Entities.Category>;
    var seasons = ViewBag.Seasons as IEnumerable<YasminLetiereConfeitaria.Domain.Entities.Sazonalidade>;
}

<section class="admin-page container">
    <div class="admin-form-card">
        <div class="form-header">
            <span class="section-tag">Atualizar Cadastro</span>
            <h1 class="page-title">Editar Produto: @Model.Name</h1>
            <p>Altere as informações abaixo e clique em Salvar para atualizar o site.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <span class="material-icons">error</span>
                <div asp-validation-summary="All">Corrija os erros abaixo.</div>
            </div>
        }

        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="admin-form">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="form-grid">
                <div class="form-group">
                    <label for="name">Nome do Doce *</label>
                    <input type="text" id="name" name="name" value="@Model.Name" required />
                </div>

                <div class="form-group">
                    <label for="price">Preço de Venda (R$) *</label>
                    <input type="number" id="price" name="price" step="0.01" min="0" value="@Model.Price.ToString("F2", new System.Globalization.CultureInfo("en-US"))" required />
                </div>
            </div>

            <div class="form-group">
                <label for="description">Descrição Apetitosa *</label>
                <textarea id="description" name="description" rows="4" required>@Model.Description</textarea>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label for="categoryId">Categoria *</label>
                    <select id="categoryId" name="categoryId" required>
                        @if (categories != null)
                        {
                            foreach (var cat in categories)
                            {
                                if (cat.Id == Model.CategoryId)
                                {
                                    <option value="@cat.Id" selected>@cat.Name</option>
                                }
                                else
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="seasonalTag">Sazonalidade</label>
                    <select id="seasonalTag" name="seasonalTag">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SeasonalTag))">Nenhum (Cardápio Fixo)</option>
                        @if (seasons != null)
                        {
                            foreach (var s in seasons)
                            {
                                var emoji = !string.IsNullOrEmpty(s.Icone) ? s.Icone :
                                            s.Nome == "Páscoa" ? "🐇" :
                                            s.Nome == "Natal" ? "🎄" :
                                            s.Nome == "Namorados" ? "💖" : "✨";
                                <option value="@s.Nome" selected="@(Model.SeasonalTag == s.Nome)">@s.Nome @emoji</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Foto do Produto (Arraste ou Clique para Alterar) *</label>
                <div class="drag-drop-zone" id="dropZone" onclick="document.getElementById('imageFile').click()">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <span class="material-icons upload-icon" style="display:none;">cloud_upload</span>
                        <p class="upload-text" style="display:none;">Arraste e solte uma imagem aqui ou clique para selecionar</p>
                        <img id="imagePreview" class="preview-thumb" src="@Model.ImageUrl" alt="Previsualização" style="display:block;" />
                    }
                    else
                    {
                        <span class="material-icons upload-icon">cloud_upload</span>
                        <p class="upload-text">Arraste e solte uma imagem aqui ou clique para selecionar</p>
                        <img id="imagePreview" class="preview-thumb" src="" alt="Previsualização" style="display:none;" />
                    }
                    <input type="file" id="imageFile" name="imageFile" accept="image/*" style="display:none;" onchange="previewImage(this)" />
                </div>
                <input type="hidden" id="imageUrl" name="imageUrl" value="@Model.ImageUrl" />
                <small class="form-help">Selecione apenas 1 foto por produto.</small>
            </div>

            <div class="form-group checkbox-group">
                <label class="checkbox-container">
                    @if (Model.IsAvailable)
                    {
                        <input type="checkbox" id="isAvailable" name="isAvailable" value="true" checked />
                    }
                    else
                    {
                        <input type="checkbox" id="isAvailable" name="isAvailable" value="true" />
                    }
                    <span class="checkmark"></span>
                    Disponível para venda (exibir no cardápio do site)
                </label>
            </div>

            <div class="form-actions-row">
                <a asp-action="Index" class="btn btn-secondary">
                    <span class="material-icons">arrow_back</span> Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <span class="material-icons">save</span> Salvar Alterações
                </button>
            </div>
        </form>

        <script>
            function previewImage(input) {
                const file = input.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const preview = document.getElementById('imagePreview');
                        const text = document.querySelector('.upload-text');
                        const icon = document.querySelector('.upload-icon');
                        
                        preview.src = e.target.result;
                        preview.style.display = 'block';
                        if (text) text.style.display = 'none';
                        if (icon) icon.style.display = 'none';
                    };
                    reader.readAsDataURL(file);
                }
            }

            const dropZone = document.getElementById('dropZone');
            if (dropZone) {
                dropZone.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    dropZone.classList.add('dragover');
                });
                dropZone.addEventListener('dragleave', () => {
                    dropZone.classList.remove('dragover');
                });
                dropZone.addEventListener('drop', (e) => {
                    e.preventDefault();
                    dropZone.classList.remove('dragover');
                    const files = e.dataTransfer.files;
                    if (files.length > 0) {
                        const fileInput = document.getElementById('imageFile');
                        fileInput.files = files;
                        previewImage(fileInput);
                    }
                });
            }
        </script>
    </div>
</section>
