@model YasminLetiereConfeitaria.Domain.Entities.Sazonalidade

@{
    ViewData["Title"] = "Editar Temporada";
    var successMsg = TempData["AdminMessage"] as string;
    var errorMsg   = TempData["AdminError"]   as string;
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <div id="adminToast" class="admin-toast toast-success" role="alert">
        <span class="material-icons toast-icon">check_circle</span>
        <div class="toast-body">
            <div class="toast-title">Operação realizada!</div>
            <div class="toast-msg">@successMsg</div>
        </div>
        <button class="toast-close" onclick="dismissToast()">✕</button>
    </div>
}
@if (!string.IsNullOrEmpty(errorMsg))
{
    <div id="adminToast" class="admin-toast toast-error" role="alert">
        <span class="material-icons toast-icon">error</span>
        <div class="toast-body">
            <div class="toast-title">Atenção!</div>
            <div class="toast-msg">@errorMsg</div>
        </div>
        <button class="toast-close" onclick="dismissToast()">✕</button>
    </div>
}

<section class="admin-page container">
    <div class="admin-header-row">
        <div>
            <span class="section-tag">Temporadas Especiais</span>
            <h1 class="page-title">Editar Temporada: @Model.Nome</h1>
            <p>Ajuste as datas de início e fim e a mensagem de expiração para esta temporada.</p>
        </div>
        <div class="header-actions">
            <a asp-action="Sazonalidades" class="btn btn-secondary">
                <span class="material-icons">arrow_back</span> Voltar
            </a>
        </div>
    </div>

    <div class="create-sazonalidade-wrapper">
        <form asp-action="UpdateSazonalidade" method="post" class="admin-form sazonalidade-card @(Model.Ativo ? "active-season" : "inactive-season")">
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="season-card-header">
                <div class="season-title-group">
                    <span class="material-icons season-icon">calendar_month</span>
                    <h3>Dados de @Model.Nome</h3>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Nome da Temporada</label>
                    <input type="text" value="@Model.Nome" disabled
                           style="padding: 10px 12px; border: 1.5px solid var(--border-ivory); border-radius: 8px; font-size: 14px; font-family: var(--font-body); width: 100%; outline: none; background-color: #eee; cursor: not-allowed;" />
                </div>

                <div class="form-group">
                    <label>Ícone / Emoji (Opcional)</label>
                    <div class="emoji-picker-container" id="editEmojiContainer">
                        @{
                            var currentEmoji = !string.IsNullOrEmpty(Model.Icone) ? Model.Icone : "✨";
                            var currentLabel = Model.Icone == "🐇" ? "Páscoa" :
                                               Model.Icone == "🎄" ? "Natal" :
                                               Model.Icone == "💖" ? "Dia dos Namorados" :
                                               Model.Icone == "🌽" ? "Festa Junina" :
                                               Model.Icone == "👩‍👦" ? "Dia das Mães" :
                                               Model.Icone == "🎃" ? "Halloween" :
                                               Model.Icone == "🎭" ? "Carnaval" :
                                               Model.Icone == "👨‍👦" ? "Dia dos Pais" :
                                               Model.Icone == "🎈" ? "Dia das Crianças" :
                                               Model.Icone == "🥂" ? "Réveillon" :
                                               Model.Icone == "💐" ? "Dia da Mulher" :
                                               Model.Icone == "🍰" ? "Bolo / Doces" :
                                               Model.Icone == "🍫" ? "Chocolate" :
                                               Model.Icone == "🍬" ? "Docinhos" :
                                               Model.Icone == "🍕" ? "Salgados" :
                                               string.IsNullOrEmpty(Model.Icone) ? "Sem ícone" : "Especial / Outro";
                        }
                        <div class="emoji-selected-preview" onclick="toggleEditEmojiPicker(event)">
                            <span class="selected-emoji-char" id="editSelectedEmojiChar">@currentEmoji</span>
                            <span class="selected-emoji-label" id="editSelectedEmojiLabel">@currentLabel</span>
                            <span class="material-icons dropdown-arrow">arrow_drop_down</span>
                        </div>
                        <input type="hidden" name="icone" id="editIconeInput" value="@Model.Icone" />
                        
                        <div class="emoji-picker-popover" id="editEmojiPopover" style="display: none;">
                            <div class="emoji-picker-grid">
                                <div class="emoji-item @(Model.Icone == "🐇" ? "active" : "")" data-emoji="🐇" data-label="Páscoa" onclick="selectEditEmoji(this)">🐇</div>
                                <div class="emoji-item @(Model.Icone == "🎄" ? "active" : "")" data-emoji="🎄" data-label="Natal" onclick="selectEditEmoji(this)">🎄</div>
                                <div class="emoji-item @(Model.Icone == "💖" ? "active" : "")" data-emoji="💖" data-label="Dia dos Namorados" onclick="selectEditEmoji(this)">💖</div>
                                <div class="emoji-item @(Model.Icone == "🌽" ? "active" : "")" data-emoji="🌽" data-label="Festa Junina" onclick="selectEditEmoji(this)">🌽</div>
                                <div class="emoji-item @(Model.Icone == "👩‍👦" ? "active" : "")" data-emoji="👩‍👦" data-label="Dia das Mães" onclick="selectEditEmoji(this)">👩‍👦</div>
                                <div class="emoji-item @(Model.Icone == "🎃" ? "active" : "")" data-emoji="🎃" data-label="Halloween" onclick="selectEditEmoji(this)">🎃</div>
                                <div class="emoji-item @(Model.Icone == "🎭" ? "active" : "")" data-emoji="🎭" data-label="Carnaval" onclick="selectEditEmoji(this)">🎭</div>
                                <div class="emoji-item @(Model.Icone == "👨‍👦" ? "active" : "")" data-emoji="👨‍👦" data-label="Dia dos Pais" onclick="selectEditEmoji(this)">👨‍👦</div>
                                <div class="emoji-item @(Model.Icone == "🎈" ? "active" : "")" data-emoji="🎈" data-label="Dia das Crianças" onclick="selectEditEmoji(this)">🎈</div>
                                <div class="emoji-item @(Model.Icone == "🥂" ? "active" : "")" data-emoji="🥂" data-label="Réveillon" onclick="selectEditEmoji(this)">🥂</div>
                                <div class="emoji-item @(Model.Icone == "💐" ? "active" : "")" data-emoji="💐" data-label="Dia da Mulher" onclick="selectEditEmoji(this)">💐</div>
                                <div class="emoji-item @(Model.Icone == "🍰" ? "active" : "")" data-emoji="🍰" data-label="Bolo / Doces" onclick="selectEditEmoji(this)">🍰</div>
                                <div class="emoji-item @(Model.Icone == "🍫" ? "active" : "")" data-emoji="🍫" data-label="Chocolate" onclick="selectEditEmoji(this)">🍫</div>
                                <div class="emoji-item @(Model.Icone == "🍬" ? "active" : "")" data-emoji="🍬" data-label="Docinhos" onclick="selectEditEmoji(this)">🍬</div>
                                <div class="emoji-item @(Model.Icone == "🍕" ? "active" : "")" data-emoji="🍕" data-label="Salgados" onclick="selectEditEmoji(this)">🍕</div>
                                <div class="emoji-item @(Model.Icone == "✨" || string.IsNullOrEmpty(Model.Icone) ? "" : "") @(Model.Icone == "✨" ? "active" : "")" data-emoji="✨" data-label="Especial" onclick="selectEditEmoji(this)">✨</div>
                                <div class="emoji-item @(string.IsNullOrEmpty(Model.Icone) ? "active" : "")" data-emoji="" data-label="Sem ícone" onclick="selectEditEmoji(this)">✕</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Data de Início *</label>
                    <input type="datetime-local" name="dataInicio"
                           value="@Model.DataInicio.ToString("yyyy-MM-ddTHH:mm")"
                           min="2024-01-01T00:00" max="2035-12-31T23:59" required />
                </div>

                <div class="form-group">
                    <label>Data de Fim *</label>
                    <input type="datetime-local" name="dataFim"
                           value="@Model.DataFim.ToString("yyyy-MM-ddTHH:mm")"
                           min="2024-01-01T00:00" max="2035-12-31T23:59" required />
                </div>
            </div>

            <div class="form-group">
                <label>Mensagem de Encerramento (Exibida quando expirado) *</label>
                <textarea name="mensagemExpirada"
                          minlength="20" maxlength="400" required
                          placeholder="Ex: Agradecemos o interesse! As encomendas desta temporada já se encerraram, mas fique de olho para as próximas novidades!">@Model.MensagemExpirada</textarea>
            </div>

            <div class="season-card-footer">
                <small class="text-muted">Atualizado em: @Model.AtualizadoEm.ToLocalTime().ToString("g")</small>
                <button type="submit" class="btn btn-primary btn-sm">
                    <span class="material-icons">save</span> Salvar Alterações
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
<script>
    (function () {
        const toast = document.getElementById('adminToast');
        if (!toast) return;
        const timer = setTimeout(() => dismissToast(), 5000);
        toast._timer = timer;
    })();

    function dismissToast() {
        const toast = document.getElementById('adminToast');
        if (!toast) return;
        clearTimeout(toast._timer);
        toast.classList.add('toast-hiding');
        toast.addEventListener('animationend', () => toast.remove(), { once: true });
    }

    /* Emoji Picker Helpers */
    function toggleEditEmojiPicker(event) {
        event.stopPropagation();
        const popover = document.getElementById('editEmojiPopover');
        popover.style.display = popover.style.display === 'none' ? 'block' : 'none';
    }

    function selectEditEmoji(element) {
        const emoji = element.getAttribute('data-emoji');
        const label = element.getAttribute('data-label');
        
        document.getElementById('editSelectedEmojiChar').innerText = emoji || '✕';
        document.getElementById('editSelectedEmojiLabel').innerText = label;
        document.getElementById('editIconeInput').value = emoji;
        
        // Remove active class from other items
        const grid = element.parentNode;
        grid.querySelectorAll('.emoji-item').forEach(item => item.classList.remove('active'));
        element.classList.add('active');
        
        document.getElementById('editEmojiPopover').style.display = 'none';
    }
    
    // Close popover when clicking outside
    document.addEventListener('click', function(event) {
        const popover = document.getElementById('editEmojiPopover');
        if (popover && !event.target.closest('#editEmojiContainer')) {
            popover.style.display = 'none';
        }
    });
</script>
}
