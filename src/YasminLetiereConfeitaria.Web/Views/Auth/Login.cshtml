@{
    ViewData["Title"] = "Entrar";
}

<section class="login-section">
    <div class="login-container">
        <div class="login-header text-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="logo-svg-login">
                <circle cx="50" cy="50" r="46" fill="#0f3260" stroke="#f5ebe0" stroke-width="1.5"/>
                <path id="curve-top-login" d="M 18,50 A 32,32 0 0,1 82,50" fill="none" />
                <path id="curve-bottom-login" d="M 82,50 A 32,32 0 0,1 18,50" fill="none" />
                <text fill="#f5ebe0" font-family="'Playfair Display', serif" font-size="7.5" font-weight="600" letter-spacing="0.5">
                    <textPath href="#curve-top-login" startOffset="50%" text-anchor="middle">Yasmin Letiere</textPath>
                </text>
                <text fill="#f5ebe0" font-family="'Playfair Display', serif" font-size="7.5" font-weight="600" letter-spacing="1">
                    <textPath href="#curve-bottom-login" startOffset="50%" text-anchor="middle">Confeitaria</textPath>
                </text>
                <path d="M 38,42 C 38,38 42,36 45,38 C 47,40 43,48 40,51 C 37,54 35,59 36,63 C 38,68 45,71 52,69 C 59,67 63,61 63,58 C 63,55 58,56 56,58 C 54,60 55,64 58,64 C 61,64 63,60 62,56 M 46,31 C 48,28 52,27 55,30 C 57,33 52,40 49,44 C 46,48 45,52 47,56 C 49,60 54,62 59,59" fill="none" stroke="#f5ebe0" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <h2>Acesso Restrito</h2>
            <p>Faça login para gerenciar produtos, preços e disponibilidades de cardápios.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <span class="material-icons">error</span>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form action="/auth/login" method="post" class="login-form">
            <div class="form-group">
                <label for="username">Usuário</label>
                <div class="input-with-icon">
                    <input type="text" id="username" name="username" placeholder="Digite seu usuário" required autofocus />
                    <span class="material-icons input-icon">person</span>
                </div>
            </div>

            <div class="form-group">
                <label for="password">Senha</label>
                <div class="input-with-icon">
                    <input type="password" id="password" name="password" placeholder="Digite sua senha" required />
                    <span class="material-icons input-icon">lock</span>
                </div>
            </div>

            <div class="form-group checkbox-group" style="margin-bottom: 24px;">
                <label class="checkbox-container" style="margin-bottom: 0; font-size: 13.5px; font-weight: 500; color: var(--primary-navy);">
                    <input type="checkbox" id="lembrar" name="lembrar" value="true" />
                    <span class="checkmark"></span>
                    Lembrar-me (Gravar acesso)
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <span class="material-icons">login</span> Entrar no Painel
            </button>
        </form>
        
        <div class="login-footer text-center">
            <a asp-controller="Home" asp-action="Index"><span class="material-icons">arrow_back</span> Voltar ao site público</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const usernameInput = document.getElementById("username");
            const lembrarCheckbox = document.getElementById("lembrar");
            const loginForm = document.querySelector(".login-form");

            // Carrega o usuário salvo se houver
            const savedUsername = localStorage.getItem("saved_username");
            if (savedUsername) {
                usernameInput.value = savedUsername;
                lembrarCheckbox.checked = true;
            }

            // Salva ou remove o usuário no submit
            if (loginForm) {
                loginForm.addEventListener("submit", function () {
                    if (lembrarCheckbox && lembrarCheckbox.checked) {
                        localStorage.setItem("saved_username", usernameInput.value);
                    } else {
                        localStorage.removeItem("saved_username");
                    }
                });
            }
        });
    </script>
}

